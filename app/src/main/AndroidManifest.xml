<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_launcher_label"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubwaveAuto">

        <!-- Android Auto: declares this app as an AA media app (see res/xml/automotive_app_desc.xml) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v0.8.1: the documented voice-search hook ("play X on <app>").
                 Assistant/Gemini can deep-link this instead of (or as well as)
                 the media-session playFromSearch route; the query becomes a
                 station song request and playback starts — same behavior as
                 the in-car voice path. singleTask so a voice launch while the
                 app is open reuses the instance via onNewIntent. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- v0.10: launcher shortcut → straight into the voice-request dialog -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- v0.5: read-only cover-art provider — Android Auto's artwork contract
             wants a LOCAL content:// URI, and this serves it. Deliberately
             exported with no permission: the covers are a public station's
             public art, metadata can't carry URI grants (it isn't an Intent),
             and gearhead/systemui package names vary too much to allowlist.
             The provider validates a strict v1/<sha256> path and refuses
             every write.
             v0.6: grantUriPermissions="true" + explicit runtime grants
             (PlaybackService.grantArtReadAccess) — some gearhead/OEM builds
             (Samsung reports) deny a plain exported read of a session-metadata
             URI unless the serving app has granted it, then render artless
             WITHOUT falling back to the inline bitmap. -->
        <provider
            android:name=".art.ArtworkProvider"
            android:authorities="${applicationId}.art"
            android:exported="true"
            android:grantUriPermissions="true"
            tools:ignore="ExportedContentProvider" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

    </application>

</manifest>
